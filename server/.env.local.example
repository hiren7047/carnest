# Local PostgreSQL — copy to server/.env:
#   copy .env.local.example .env   (Windows)
#   cp .env.local.example .env     (Mac/Linux)
#
# Option A: Docker Postgres (port 5433 on host — avoids conflict with local PG on 5432)
#   cd carnest && docker compose up -d
#
# Option B: Your existing local PostgreSQL — set DB_USER/DB_PASSWORD below

NODE_ENV=development
PORT=4000

DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=carnest_db
DB_USER=carnest
DB_PASSWORD=carnest_local

DB_SYNC_ALTER=true
DB_TIMEZONE=+05:30
DB_SSL=false

JWT_SECRET=local-dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:8080
CLIENT_URLS=http://localhost:8080,http://localhost:8090
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000

# Demo hub — same DB (1 database, separate tables)
DEMO_HUB_DB_HOST=127.0.0.1
DEMO_HUB_DB_PORT=5433
DEMO_HUB_DB_USER=carnest
DEMO_HUB_DB_PASSWORD=carnest_local
DEMO_HUB_DB_SYNC_ALTER=true

HUB_ADMIN_EMAIL=you@carnest.in
HUB_ADMIN_PASSWORD=HubAdmin123!
DEMO_PUBLIC_BASE_URL=http://localhost:8080/d
