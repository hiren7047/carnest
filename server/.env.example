NODE_ENV=development
PORT=4000

# --- PostgreSQL (production + local default) ---
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=carnest_db
DB_USER=carnest
DB_PASSWORD=

# India IST
DB_TIMEZONE=+05:30
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_SSL=false

# true on first run adds missing columns to existing tables
DB_SYNC_ALTER=true
# After first successful start in production, set DB_SYNC_ALTER=false

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:8080
CLIENT_URLS=http://localhost:8080,http://localhost:8090
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000

# --- Demo Hub (same PostgreSQL database as DB_NAME) ---
# Omit DEMO_HUB_DB_NAME to use DB_NAME (recommended: 1 DB)
DEMO_HUB_DB_HOST=127.0.0.1
DEMO_HUB_DB_PORT=5432
DEMO_HUB_DB_USER=carnest
DEMO_HUB_DB_PASSWORD=

# true on first run creates demo_* / template_* tables
DEMO_HUB_DB_SYNC_ALTER=true

HUB_ADMIN_EMAIL=you@carnest.in
HUB_ADMIN_PASSWORD=HubAdmin123!
DEMO_PUBLIC_BASE_URL=http://localhost:8080/d

# --- Optional: MySQL/MariaDB (local legacy only) ---
# DB_DIALECT=mysql
# DB_PORT=3306
# DB_NAME=carnest

# Optional Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
